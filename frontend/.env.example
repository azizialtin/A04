# Copy to .env.local for local dev.
VITE_API_BASE_URL=http://localhost:8030

# Optional — address of the Tobii bridge (defaults to ws://127.0.0.1:8766).
# VITE_TOBII_WS_URL=ws://127.0.0.1:8766

# Lab display guard: opt in with `npm run dev:lab`, or enable explicitly here.
# It checks the display, shows the settings to the study lead and records them;
# gaze on an unverified display is kept but not assigned to areas. Without the
# measuring Windows bridge, verification needs a single 1920x1080 display,
# Windows scaling/Edge zoom 100% and fullscreen.
# VITE_LAB_DISPLAY_GUARD=true
# By default it never stops the participant. This restores the blocking dialog
# and its study-lead confirmation.
# VITE_LAB_DISPLAY_GUARD_BLOCKING=true
