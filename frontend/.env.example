# Copy to .env.local for local dev.
VITE_API_BASE_URL=http://localhost:8030

# Optional — address of the Tobii bridge (defaults to ws://127.0.0.1:8766).
# VITE_TOBII_WS_URL=ws://127.0.0.1:8766

# Lab display guard: opt in with `npm run dev:lab`, or enable explicitly here.
# Requires a single 1920x1080 display, Windows scaling/Edge zoom 100%, fullscreen,
# and operator confirmation before measured tasks. CK's server deadline continues.
# VITE_LAB_DISPLAY_GUARD=true
