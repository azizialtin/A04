# Copy to .env for local dev. Never commit the real .env.
DATABASE_URL=postgresql+asyncpg://a04:a04@localhost:5434/a04
JWT_SECRET=dev-secret-change-me-before-you-ship-this
FRONTEND_URL=http://localhost:5175,http://localhost:5173
ENVIRONMENT=development

# Leave GCP_BUCKET_NAME empty locally -> videos served from ./uploads/videos.
GCP_BUCKET_NAME=
DEV_PLACEHOLDER_VIDEO_URL=

# Gaze data goes to disk in dev, GCS in prod.
GAZE_STORAGE_MODE=local

# Screen capture behind the think-aloud. Recorded by the bridge on the lab
# machine, which needs ffmpeg; a case is a few hundred megabytes, so in
# production this must be `gcs` and the app refuses to start otherwise.
SCREEN_RECORDING_ENABLED=true
SCREEN_STORAGE_MODE=local
